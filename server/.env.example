# Copy this file to .env and fill in your own values. Never commit .env.

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/sweety
# Used only by `npm test` (use a separate database – tests wipe its tables)
TEST_DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/sweety_test

# Auth – generate a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS: URL(s) the React app runs on (comma separated)
CLIENT_ORIGIN=http://localhost:5173

# Timezone that decides what "today" / "future date" means
APP_TIMEZONE=Asia/Kolkata

# Set to true to let Express serve the built React app (client/dist)
SERVE_CLIENT=false
